extends ../layout

block content
  .main-content
    .page-header
      div
        h1 User Details
        p Viewing user ##{userData.id}
      .action-group
        a.btn.btn-secondary(href="/users") ← Back to Users
        a.btn.btn-primary(href=`/users/${userData.id}/edit`) Edit User

    .profile-grid
      .card
        .profile-header
          .profile-avatar= userData.full_name ? userData.full_name.charAt(0).toUpperCase() : '?'
          .profile-info
            h2= userData.full_name
            p= userData.email

        .detail-row
          span.detail-label User ID
          span.detail-value= userData.id

        .detail-row
          span.detail-label Email
          span.detail-value= userData.email

        .detail-row
          span.detail-label Full Name
          span.detail-value= userData.full_name

        .detail-row
          span.detail-label Status
          span.detail-value
            if userData.is_active
              span.badge.badge-success
                span.badge-dot
                | Active
            else
              span.badge.badge-danger
                span.badge-dot
                | Inactive

        if userData.created_at
          .detail-row
            span.detail-label Created
            span.detail-value= new Date(userData.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

        if userData.updated_at
          .detail-row
            span.detail-label Last Updated
            span.detail-value= new Date(userData.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
