extends ../layout

block content
  .page-header
    div
      h1 Event QR Scanner
      p(style="color:var(--text-secondary); margin-top:0.25rem;") Scan student check-in codes to record attendance and award points.

  .card(style="max-width: 600px; margin: 0 auto;")
    div#reader(style="width: 100%; min-height: 300px;")
    
    div#scan-result(style="display:none; margin-top: 20px;")
      .alert.alert-success(style="background:#f0fdf4; color:#166534; border:1px solid #bbf7d0;")
        h3(style="margin-top:0; margin-bottom:10px;") ✅ Valid QR Code Scanned!
        p <strong>Student:</strong> <span id="res-student-name"></span> (<span id="res-student-number"></span>)
        p <strong>Event:</strong> <span id="res-event-name"></span>
        p <strong>Task:</strong> <span id="res-task-name"></span>

      form#points-form(style="margin-top: 20px;")
        input(type="hidden" id="res-app-id")
        .form-group
          label(style="font-weight:600;") Points to Award
          input.form-control(type="number" id="points-input" min="0" required)
        button.btn.btn-primary(type="submit" style="width: 100%;") Award Points &amp; Mark Attended
      
      button.btn.btn-outline(type="button" id="btn-scan-again" style="width:100%; margin-top:10px;") Scan Another Code

  script(src="https://unpkg.com/html5-qrcode")
  script.
    document.addEventListener("DOMContentLoaded", () => {
      const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: {width: 250, height: 250} }, false);
      const scanResultDiv = document.getElementById('scan-result');
      const readerDiv = document.getElementById('reader');
      
      async function onScanSuccess(decodedText, decodedResult) {
        // Pause scanner
        html5QrcodeScanner.pause();
        
        try {
          const res = await fetch('/grader/scan/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: decodedText })
          });
          
          const data = await res.json();
          if (data.success) {
            document.getElementById('res-student-name').textContent = data.studentName;
            document.getElementById('res-student-number').textContent = data.studentNumber;
            document.getElementById('res-event-name').textContent = data.eventName;
            document.getElementById('res-task-name').textContent = data.taskName;
            document.getElementById('res-app-id').value = data.application_id;
            
            readerDiv.style.display = 'none';
            scanResultDiv.style.display = 'block';
          } else {
            alert(data.message || "Invalid QR Code.");
            html5QrcodeScanner.resume();
          }
        } catch (e) {
          alert("Error verifying QR code. Please try again.");
          html5QrcodeScanner.resume();
        }
      }

      function onScanFailure(error) {
        // handle scan failure, usually better to ignore and keep scanning
      }

      html5QrcodeScanner.render(onScanSuccess, onScanFailure);

      document.getElementById('btn-scan-again').addEventListener('click', () => {
        scanResultDiv.style.display = 'none';
        readerDiv.style.display = 'block';
        document.getElementById('points-input').value = '';
        html5QrcodeScanner.resume();
      });

      document.getElementById('points-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const appId = document.getElementById('res-app-id').value;
        const points = document.getElementById('points-input').value;
        
        try {
          const res = await fetch('/grader/scan/award-points', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ application_id: appId, points: points })
          });
          const data = await res.json();
          if (data.success) {
            alert("Points awarded successfully!");
            document.getElementById('btn-scan-again').click();
          } else {
            alert(data.message || "Failed to award points.");
          }
        } catch (err) {
          alert("Error saving points.");
        }
      });
    });
