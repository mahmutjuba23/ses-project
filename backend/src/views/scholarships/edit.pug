extends ../layout

block content
  .main-content
    .page-header
      div
        h1 Edit Scholarship
        p Editing: #{scholarship.title}
      a.btn.btn-secondary(href=`/scholarships/${scholarship.id}`) ← Back

    .card(style="max-width:620px;")
      if error
        .alert.alert-error= error

      form(action=`/scholarships/${scholarship.id}` method="POST")
        input(type="hidden" name="_method" value="PATCH")

        .form-group
          label(for="title") Title
          input#title.form-control(
            type="text"
            name="title"
            required
            value=scholarship.title || ''
          )

        .form-group
          label(for="description") Description
          textarea#description.form-control(
            name="description"
            rows="4"
            style="resize:vertical;"
          )= scholarship.description || ''

        .form-group
          label(for="amount") Amount ($)
          input#amount.form-control(
            type="number"
            name="amount"
            required
            min="1"
            step="0.01"
            value=scholarship.amount || ''
          )

        .form-group
          label(for="deadline") Application Deadline
          input#deadline.form-control(
            type="date"
            name="deadline"
            required
            value=scholarship.deadline || ''
          )

        .form-group
          label(for="status") Status
          select#status.form-control(name="status")
            option(value="draft" selected=(scholarship.status==='draft' ? true : false)) Draft
            option(value="open" selected=(scholarship.status==='open' ? true : false)) Open
            option(value="closed" selected=(scholarship.status==='closed' ? true : false)) Closed

        button.btn.btn-primary(type="submit") Save Changes
