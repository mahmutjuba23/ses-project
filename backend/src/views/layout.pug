doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'SES - Scholarship Engagement System'
    meta(name="description" content=metaDescription || 'Scholarship Engagement System')
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    style.
      :root {
        --bg-primary: #f8fafc;
        --bg-secondary: #ffffff;
        --bg-card: #ffffff;
        --bg-input: #ffffff;
        --border-color: #e2e8f0;
        --border-focus: #2563eb;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #94a3b8;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --accent-glow: rgba(37, 99, 235, 0.2);
        --success: #10b981;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --warning: #f59e0b;
        --gradient-1: linear-gradient(135deg, #2563eb, #3b82f6);
        --gradient-2: linear-gradient(135deg, #f8fafc, #ffffff);
        --radius: 8px;
        --radius-sm: 6px;
        --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
        --transition: all 0.25s ease;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        min-height: 100vh;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* ── App Shell Layout ── */
      .app-shell {
        display: flex;
        min-height: 100vh;
      }

      /* ── Sidebar ── */
      .sidebar {
        width: 240px;
        min-width: 240px;
        background: var(--bg-secondary);
        border-right: 1px solid var(--border-color);
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        z-index: 100;
        overflow-y: auto;
        overflow-x: hidden;
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.5rem 1.25rem;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
        border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
      }

      .sidebar-brand .logo-icon {
        width: 32px;
        height: 32px;
        min-width: 32px;
        background: var(--gradient-1);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        color: #fff;
      }

      .sidebar-nav {
        list-style: none;
        padding: 1rem 0.75rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .sidebar-section-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 1rem 0.5rem 0.4rem;
        margin-top: 0.5rem;
      }

      .sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        text-decoration: none;
        color: var(--text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
        transition: var(--transition);
        white-space: nowrap;
      }

      .sidebar-nav a .nav-icon {
        font-size: 1rem;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
      }

      .sidebar-nav a:hover {
        color: var(--text-primary);
        background: var(--bg-primary);
      }

      .sidebar-nav a.active {
        color: var(--accent);
        background: rgba(37, 99, 235, 0.08);
        font-weight: 600;
      }

      .sidebar-footer {
        padding: 1rem 0.75rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .sidebar-footer a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        text-decoration: none;
        color: var(--text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
        transition: var(--transition);
      }

      .sidebar-footer a:hover {
        color: var(--text-primary);
        background: var(--bg-primary);
      }

      .sidebar-footer a.active {
        color: var(--accent);
        background: rgba(37, 99, 235, 0.08);
      }

      /* ── Main Content Area ── */
      .page-wrapper {
        margin-left: 240px;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .main-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        width: 100%;
      }

      /* ── Responsive: collapse sidebar on small screens ── */
      @media (max-width: 900px) {
        .sidebar { display: none; }
        .page-wrapper { margin-left: 0; }
      }

      /* ── Auth Layout ── */
      .auth-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 64px);
        padding: 2rem;
      }

      .auth-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2.5rem;
        width: 100%;
        max-width: 440px;
        box-shadow: var(--shadow-lg);
        animation: fadeSlideUp 0.5s ease;
      }

      @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .auth-card h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
      }

      .auth-card .subtitle {
        color: var(--text-secondary);
        font-size: 0.9375rem;
        margin-bottom: 2rem;
      }

      /* ── Forms ── */
      .form-group {
        margin-bottom: 1.25rem;
      }

      .form-group label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-size: 0.9375rem;
        font-family: inherit;
        transition: var(--transition);
        outline: none;
      }

      .form-control:focus {
        border-color: var(--border-focus);
        box-shadow: 0 0 0 3px var(--accent-glow);
      }

      .form-control::placeholder {
        color: var(--text-muted);
      }

      /* ── Buttons ── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        line-height: 1;
      }

      .btn-primary {
        background: var(--gradient-1);
        color: #fff;
        box-shadow: 0 2px 12px var(--accent-glow);
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 20px var(--accent-glow);
      }

      .btn-secondary {
        background: var(--bg-input);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
      }

      .btn-secondary:hover {
        border-color: var(--text-muted);
        background: var(--bg-secondary);
      }

      .btn-danger {
        background: var(--danger);
        color: #fff;
      }

      .btn-danger:hover {
        background: var(--danger-hover);
        transform: translateY(-1px);
      }

      .btn-sm {
        padding: 0.5rem 0.875rem;
        font-size: 0.8125rem;
      }

      .btn-block {
        width: 100%;
      }

      /* ── Page Header ── */
      .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .page-header p {
        color: var(--text-secondary);
        font-size: 0.9375rem;
        margin-top: 0.25rem;
      }

      /* ── Table ── */
      .table-wrapper {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        animation: fadeSlideUp 0.5s ease;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead {
        background: var(--bg-primary);
      }

      th {
        text-align: left;
        padding: 1rem 1.25rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-color);
      }

      td {
        padding: 1rem 1.25rem;
        font-size: 0.9375rem;
        border-bottom: 1px solid rgba(45, 49, 72, 0.5);
        vertical-align: middle;
      }

      tr {
        transition: var(--transition);
      }

      tbody tr:hover {
        background: var(--bg-primary);
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      /* ── Badges ── */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .badge-success {
        background: rgba(34, 197, 94, 0.15);
        color: var(--success);
      }

      .badge-danger {
        background: rgba(239, 68, 68, 0.15);
        color: var(--danger);
      }

      .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
      }

      /* ── Action Buttons ── */
      .action-group {
        display: flex;
        gap: 0.5rem;
      }

      /* ── Card ── */
      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 2rem;
        box-shadow: var(--shadow);
        animation: fadeSlideUp 0.5s ease;
      }

      .card h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
      }

      /* ── Profile ── */
      .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .profile-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .profile-avatar {
        width: 72px;
        height: 72px;
        background: var(--gradient-1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
      }

      .profile-info h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
      }

      .profile-info p {
        color: var(--text-secondary);
        font-size: 0.9375rem;
      }

      .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(45, 49, 72, 0.5);
      }

      .detail-row:last-child {
        border-bottom: none;
      }

      .detail-label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .detail-value {
        font-size: 0.9375rem;
        font-weight: 500;
      }

      /* ── Alerts ── */
      .alert {
        padding: 1rem 1.25rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid;
        animation: fadeSlideUp 0.3s ease;
      }

      .alert-error {
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.3);
        color: #fca5a5;
      }

      .alert-success {
        background: rgba(34, 197, 94, 0.1);
        border-color: rgba(34, 197, 94, 0.3);
        color: #86efac;
      }

      /* ── Auth Links ── */
      .auth-footer {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .auth-footer a {
        color: var(--accent-hover);
        text-decoration: none;
        font-weight: 500;
        transition: var(--transition);
      }

      .auth-footer a:hover {
        color: #c7d2fe;
        text-decoration: underline;
      }

      /* ── Delete confirmation ── */
      .confirm-dialog {
        text-align: center;
        padding: 1rem 0;
      }

      .confirm-dialog p {
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
        font-size: 0.9375rem;
      }

      .confirm-dialog .btn-group {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
      }

      /* ── Responsive ── */
      @media (max-width: 768px) {
        .navbar { padding: 0 1rem; }
        .main-content { padding: 1.5rem 1rem; }
        .page-header { flex-direction: column; align-items: flex-start; }
        .table-wrapper { overflow-x: auto; }
        th, td { padding: 0.75rem; font-size: 0.8125rem; }
        .profile-header { flex-direction: column; text-align: center; }
        .profile-grid { grid-template-columns: 1fr; }
      }

    block styles

  body
    .app-shell
      //- ── Sidebar ──
      if user
        nav.sidebar
          a.sidebar-brand(href="/")
            span.logo-icon SES
            span SES

          ul.sidebar-nav
            li
              a(href="/scholarships" class=(currentPage === 'scholarships' ? 'active' : ''))
                span.nav-icon 🎓
                | Scholarships

            if user.roles && user.roles.includes('admin')
              li.sidebar-section-label Admin
              li
                a(href="/dashboard" class=(currentPage === 'dashboard' ? 'active' : ''))
                  span.nav-icon 📊
                  | Dashboard
              li
                a(href="/admin/users" class=(currentPage === 'admin-users' ? 'active' : ''))
                  span.nav-icon 👥
                  | Users
              li
                a(href="/admin/students" class=(currentPage === 'admin-students' ? 'active' : ''))
                  span.nav-icon 🎒
                  | Students
              li
                a(href="/admin/periods" class=(currentPage === 'admin-periods' ? 'active' : ''))
                  span.nav-icon 📅
                  | Periods
              li
                a(href="/admin/events" class=(currentPage === 'admin-events' ? 'active' : ''))
                  span.nav-icon 🗓️
                  | Events
              li
                a(href="/grader/scan" class=(currentPage === 'grader-scan' ? 'active' : ''))
                  span.nav-icon 📷
                  | QR Scanner
            else
              li.sidebar-section-label Student
              li
                a(href="/dashboard" class=(currentPage === 'dashboard' ? 'active' : ''))
                  span.nav-icon 📊
                  | Dashboard
              li
                a(href="/calls" class=(currentPage === 'student-calls' ? 'active' : ''))
                  span.nav-icon 📋
                  | Available Calls
              li
                a(href="/calls/my-tasks" class=(currentPage === 'student-tasks' ? 'active' : ''))
                  span.nav-icon ✅
                  | My Tasks

          .sidebar-footer
            a(href="/auth/me" class=(currentPage === 'profile' ? 'active' : ''))
              span.nav-icon 👤
              | Profile
            a(href="/auth/login")
              span.nav-icon 🚪
              | Logout
      else
        nav.sidebar
          a.sidebar-brand(href="/")
            span.logo-icon SES
            span SES
          ul.sidebar-nav
            li
              a(href="/scholarships" class=(currentPage === 'scholarships' ? 'active' : ''))
                span.nav-icon 🎓
                | Scholarships
          .sidebar-footer
            a(href="/auth/login" class=(currentPage === 'login' ? 'active' : ''))
              span.nav-icon 🔑
              | Login
            a(href="/auth/register" class=(currentPage === 'register' ? 'active' : ''))
              span.nav-icon ✍️
              | Register

      //- ── Page Content ──
      .page-wrapper
        if success
          .main-content: .alert.alert-success= success
        if error
          .main-content: .alert.alert-error= error

        block content
