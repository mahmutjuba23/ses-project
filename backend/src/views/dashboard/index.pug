extends ../layout

block content
  style.
    .dash-wrap { display: flex; gap: 0; min-height: calc(100vh - 60px); animation: fadeIn 0.3s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* --- Faculty Sidebar --- */
    .faculty-sidebar {
      width: 240px;
      flex-shrink: 0;
      background: var(--bg-card);
      border-right: 1px solid var(--border-color);
      padding: 28px 0;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    .faculty-sidebar-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 0 20px 14px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 8px;
    }

    /* Faculty item with hover-reveal departments */
    .faculty-item { position: relative; }
    .faculty-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 11px 20px;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9rem;
      color: var(--text-primary);
      text-align: left;
      transition: background 0.15s, color 0.15s;
      border-left: 3px solid transparent;
    }
    .faculty-btn:hover, .faculty-item:hover .faculty-btn { background: rgba(14,165,233,0.06); color: var(--accent); border-left-color: var(--accent); }
    .faculty-btn.active { background: rgba(14,165,233,0.1); color: var(--accent); font-weight: 600; border-left-color: var(--accent); }
    .faculty-btn .arrow { font-size: 0.7rem; transition: transform 0.2s; }
    .faculty-item:hover .arrow { transform: rotate(90deg); }

    /* Department flyout — appears on hover */
    .dept-flyout {
      display: none;
      position: absolute;
      left: 240px;
      top: 0;
      min-width: 220px;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 0 10px 10px 0;
      box-shadow: 6px 0 24px rgba(0,0,0,0.15);
      z-index: 100;
      padding: 6px 0;
    }
    .faculty-item:hover .dept-flyout { display: block; }
    .dept-flyout-title { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; padding: 8px 16px 6px; }
    .dept-link {
      display: block;
      padding: 9px 16px;
      font-size: 0.88rem;
      color: var(--text-secondary);
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
      border-left: 3px solid transparent;
    }
    .dept-link:hover { background: rgba(14,165,233,0.06); color: var(--accent); border-left-color: var(--accent); }
    .dept-link.active { background: rgba(14,165,233,0.1); color: var(--accent); font-weight: 600; border-left-color: var(--accent); }

    /* Show all button in flyout */
    .dept-link-all { border-bottom: 1px solid var(--border-color); margin-bottom: 4px; font-style: italic; }

    /* --- Main Content --- */
    .dash-main { flex: 1; padding: 30px; overflow-x: hidden; }

    .page-header { margin-bottom: 25px; }
    .page-header h1 { margin: 0 0 4px; font-size: 1.8rem; font-weight: 700; color: var(--text-primary); }
    .page-header p { margin: 0; color: var(--text-secondary); font-size: 0.95rem; }

    .stats-bar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 25px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px 22px; display: flex; align-items: center; gap: 14px; box-shadow: var(--shadow); }
    .stat-icon { font-size: 1.8rem; }
    .stat-val { font-size: 1.8rem; font-weight: 700; line-height: 1; }
    .stat-lbl { font-size: 0.82rem; color: var(--text-secondary); margin-top: 3px; }
    .stat-card.c-accent .stat-val { color: var(--accent); }
    .stat-card.c-success .stat-val { color: var(--success); }
    .stat-card.c-warn .stat-val { color: #fbbf24; }

    /* Breadcrumb */
    .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 16px; flex-wrap: wrap; }
    .breadcrumb a { color: var(--accent); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .breadcrumb .sep { color: var(--border-color); }

    /* Results */
    .results-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
    .results-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 1px solid var(--border-color); }
    .results-header h3 { margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--text-primary); }
    .count-badge { background: var(--bg-secondary); color: var(--text-secondary); font-size: 0.82rem; padding: 3px 12px; border-radius: 20px; }

    .modern-table { width: 100%; border-collapse: collapse; }
    .modern-table th { background: var(--bg-secondary); padding: 11px 16px; text-align: left; font-weight: 600; font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
    .modern-table td { padding: 13px 16px; border-bottom: 1px solid rgba(0,0,0,0.04); font-size: 0.92rem; vertical-align: middle; }
    .modern-table tbody tr { cursor: pointer; transition: background 0.12s; }
    .modern-table tbody tr:hover { background: rgba(14,165,233,0.05); }
    .modern-table tbody tr:last-child td { border-bottom: none; }

    .sname { font-weight: 600; color: var(--text-primary); }
    .sid { font-size: 0.8rem; color: var(--accent); margin-top: 2px; }
    .pill { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
    .pill-bachelor { background: rgba(99,102,241,0.12); color: #818cf8; }
    .pill-master { background: rgba(14,165,233,0.12); color: #38bdf8; }
    .pill-active { background: rgba(16,185,129,0.12); color: var(--success); }
    .pill-inactive { background: rgba(239,68,68,0.12); color: var(--danger); }
    .schol-full { color: var(--success); font-weight: 600; font-size: 0.85rem; }
    .schol-partial { color: #fbbf24; font-weight: 600; font-size: 0.85rem; }
    .schol-none { color: var(--text-muted); font-size: 0.85rem; }

    .empty-state { text-align: center; padding: 70px 20px; }
    .empty-state .ei { font-size: 3.5rem; margin-bottom: 12px; }
    .empty-state h3 { margin: 0 0 8px; color: var(--text-primary); font-size: 1.15rem; }
    .empty-state p { margin: 0; color: var(--text-secondary); font-size: 0.9rem; }

  .dash-wrap
    //- Faculty Sidebar
    nav.faculty-sidebar
      .faculty-sidebar-title 🏛 Faculties
      each f in faculties
        - var fDepts = allDepartments[f] || []
        .faculty-item
          button.faculty-btn(class=(selectedFaculty===f ? 'active' : '') onclick=`window.location='/dashboard?faculty=${encodeURIComponent(f)}'`)
            span= f
            span.arrow ›
          
          //- Hover flyout with departments
          .dept-flyout
            .dept-flyout-title #{f}
            a.dept-link.dept-link-all(href=`/dashboard?faculty=${encodeURIComponent(f)}` class=(!selectedDepartment && selectedFaculty===f ? 'active' : '')) All departments
            each d in fDepts
              a.dept-link(href=`/dashboard?faculty=${encodeURIComponent(f)}&department=${encodeURIComponent(d)}` class=(selectedDepartment===d && selectedFaculty===f ? 'active' : ''))= d

    //- Main content
    main.dash-main
      .page-header
        h1 Student Directory
        p Scholarship Engagement System — academic overview

      .stats-bar
        .stat-card.c-accent
          .stat-icon 🎓
          div
            .stat-val= stats.totalStudents
            .stat-lbl Total Students
        .stat-card.c-success
          .stat-icon ✅
          div
            .stat-val= stats.activeStudents
            .stat-lbl Active Students
        .stat-card.c-warn
          .stat-icon 🏛️
          div
            .stat-val= stats.totalFaculties
            .stat-lbl Faculties

      if selectedFaculty
        .breadcrumb
          a(href="/dashboard") All Faculties
          span.sep ›
          if selectedDepartment
            a(href=`/dashboard?faculty=${encodeURIComponent(selectedFaculty)}`)= selectedFaculty
            span.sep ›
            span= selectedDepartment
          else
            span= selectedFaculty

      .results-card
        .results-header
          h3
            if selectedDepartment
              | #{selectedDepartment}
            else if selectedFaculty
              | #{selectedFaculty} — All Departments
            else
              | 👈 Select a Faculty to view students
          if students.length > 0
            span.count-badge #{students.length} student#{students.length !== 1 ? 's' : ''}

        if students.length === 0
          .empty-state
            .ei #{selectedFaculty ? '🔍' : '🏛️'}
            h3= selectedFaculty ? 'No students found' : 'Choose a Faculty'
            p= selectedFaculty ? 'No students match the selected filters.' : 'Hover over a faculty in the sidebar to browse departments and students.'
        else
          .table-responsive
            table.modern-table
              thead
                tr
                  th Student
                  th Program
                  th Level
                  th Enrolled
                  th Scholarship
                  th Status
              tbody
                each s in students
                  tr(onclick=`window.location='/admin/students/${s.id}'`)
                    td
                      div.sname #{s.first_name} #{s.last_name}
                      div.sid= s.student_number
                    td(style="max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-secondary);")= s.program || '—'
                    td
                      if s.study_level === 'Master'
                        span.pill.pill-master Master
                      else
                        span.pill.pill-bachelor Bachelor
                    td(style="color: var(--text-secondary);")= s.enrolment_year || '—'
                    td
                      if s.scholarship_type === 'Full'
                        span.schol-full ★ Full
                      else if s.scholarship_type === 'Partial'
                        span.schol-partial ◑ #{s.scholarship_percentage}%
                      else
                        span.schol-none —
                    td
                      if s.is_active
                        span.pill.pill-active Active
                      else
                        span.pill.pill-inactive Inactive
