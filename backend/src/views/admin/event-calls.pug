extends ../layout

block content
  style.
    .calls-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      animation: fadeIn 0.4s ease-out;
    }
    body::-webkit-scrollbar, dialog::-webkit-scrollbar, textarea::-webkit-scrollbar { display: none; }
    body, dialog, textarea { -ms-overflow-style: none; scrollbar-width: none; }
    body:has(dialog[open]) { overflow: hidden; }

    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--border-color);
    }
    .admin-header h1 { margin: 0; color: var(--text-primary); font-size: 2rem; font-weight: 600; }
    .admin-header p  { margin: 5px 0 0; color: var(--text-secondary); font-size: 0.95rem; }
    .header-actions { display: flex; gap: 10px; align-items: center; }

    .card {
      background: var(--bg-card);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 25px;
      margin-bottom: 30px;
      border: 1px solid var(--border-color);
    }
    .table-responsive { overflow-x: auto; border-radius: 8px; }

    table.modern-table { width: 100%; border-collapse: collapse; text-align: left; }
    table.modern-table th {
      background-color: var(--bg-secondary); color: var(--text-secondary); font-weight: 600;
      padding: 15px; border-bottom: 2px solid var(--border-color);
      font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    table.modern-table td {
      padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05);
      color: var(--text-primary); font-size: 0.95rem; vertical-align: middle;
    }
    table.modern-table tbody tr:hover { background-color: rgba(255,255,255,0.04); }

    .btn-modern {
      padding: 10px 20px; border-radius: 8px; font-weight: 500;
      transition: all 0.2s; border: none; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      text-decoration: none; gap: 6px;
    }
    .btn-modern-primary {
      background: var(--gradient-1); color: white;
      box-shadow: 0 4px 15px var(--accent-glow);
    }
    .btn-modern-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px var(--accent-glow); }
    .btn-modern-outline {
      background: transparent; color: var(--text-secondary);
      border: 1px solid var(--border-color);
    }
    .btn-modern-outline:hover { color: var(--text-primary); border-color: var(--accent); }
    .btn-modern-sm { padding: 6px 12px; font-size: 0.85rem; border-radius: 6px; }
    .btn-modern-danger {
      background-color: var(--danger); color: white;
    }
    .btn-modern-danger:hover { background-color: #dc2626; transform: translateY(-1px); }

    dialog::backdrop {
      background-color: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
    }
    dialog {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
    }
    dialog[open] {
      animation: modalFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-control-modern {
      width: 100%; padding: 10px 15px;
      background: var(--bg-input); border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 6px; font-size: 0.95rem;
      transition: border-color 0.2s, box-shadow 0.2s; box-sizing: border-box;
    }
    .form-control-modern:focus {
      outline: none; border-color: var(--border-focus);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
    .form-group-modern { margin-bottom: 18px; }
    .form-group-modern label {
      display: block; margin-bottom: 6px; font-weight: 500;
      color: var(--text-secondary); font-size: 0.9rem;
    }
    
    .status-badge {
      padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
    }
    .status-yes { background-color: rgba(16, 185, 129, 0.15); color: var(--success); }
    .status-no { background-color: rgba(100, 116, 139, 0.15); color: var(--text-muted); }

  .calls-container
    .admin-header
      div
        h1 Calls for Event: #{event.title}
        p Manage volunteer tasks for this specific event.
      .header-actions
        a.btn-modern.btn-modern-outline(href="/admin/events") &larr; Back to Events

    if pageWarning === 'dates_invalid'
      .alert.alert-warning(style="background: rgba(245, 158, 11, 0.15); color: var(--warning); padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.3);") Error: Application end date must be after start date.
    else if pageWarning === 'invalid_json'
      .alert.alert-warning(style="background: rgba(245, 158, 11, 0.15); color: var(--warning); padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.3);") Error: Eligibility rule is not valid JSON.
    else if pageWarning
      .alert.alert-warning(style="background: rgba(245, 158, 11, 0.15); color: var(--warning); padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.3);") An error occurred. Please try again.

    button.btn-modern.btn-modern-primary(onclick="document.getElementById('createCallModal').showModal()" style="margin-bottom: 20px;")
      span(style="font-size: 1.2rem; margin-right: 5px;") +
      | Create New Call

    .card
      .table-responsive
        table.modern-table
          thead
            tr
              th Task Type
              th Quota
              th Application Window
              th Task Dates
              th Auto Approve
              th Waitlist
              th Actions
          tbody
            if calls.length === 0
              tr
                td(colspan="7" style="text-align:center; color: var(--text-muted); padding: 3rem;") No calls created yet.
            each c in calls
              tr
                td(style="font-weight: 500; color: var(--text-primary);")= c.TaskType ? c.TaskType.name : '—'
                td= c.quota
                td(style="color: var(--text-secondary); font-size: 0.9rem;")
                  | #{c.application_start ? new Date(c.application_start).toLocaleDateString() : '—'}
                  br
                  |  → #{c.application_end ? new Date(c.application_end).toLocaleDateString() : '—'}
                td(style="color: var(--text-secondary); font-size: 0.9rem;")
                  | #{c.task_start ? new Date(c.task_start).toLocaleDateString() : '—'}
                  br
                  |  → #{c.task_end ? new Date(c.task_end).toLocaleDateString() : '—'}
                td
                  span.status-badge(class=c.auto_approve ? 'status-yes' : 'status-no')= c.auto_approve ? 'Yes' : 'No'
                td
                  span.status-badge(class=c.has_waitlist ? 'status-yes' : 'status-no')= c.has_waitlist ? 'Yes' : 'No'
                td
                  div(style="display: flex; gap: 8px; align-items: center;")
                    a.btn-modern.btn-modern-primary.btn-modern-sm(href=`/admin/calls/${c.id}/applications`) Review Apps
                    form(action="/admin/events/calls/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this call?')")
                      input(type="hidden" name="call_id" value=c.id)
                      input(type="hidden" name="event_id" value=event.id)
                      button.btn-modern.btn-modern-danger.btn-modern-sm(type="submit") Delete

    dialog#createCallModal(style="padding: 30px; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-primary); border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); width: 550px; max-width: 90vw;")
      div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;")
        h3(style="margin: 0; color: var(--text-primary); font-size: 1.4rem; font-weight: 600;") Create Call for #{event.title}
        button(onclick="document.getElementById('createCallModal').close()" style="background: var(--bg-secondary); border: none; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-secondary); transition: all 0.2s; font-size: 1.2rem;" title="Close") &times;
      
      form(action="/admin/events/calls/create" method="POST")
        input(type="hidden" name="event_id" value=event.id)
        
        div(style="display: flex; gap: 15px;")
          .form-group-modern(style="flex: 2;")
            label Task Type
            select.form-control-modern(name="task_type_id" required)
              option(value="") -- Select Task Type --
              each tt in taskTypes
                option(value=tt.id)= tt.name
          .form-group-modern(style="flex: 1;")
            label Quota (max students)
            input.form-control-modern(type="number" name="quota" min="1" step="1" required)

        div(style="display: flex; gap: 15px;")
          .form-group-modern(style="flex: 1;")
            label Application Start
            input.form-control-modern(type="datetime-local" name="application_start" step="any" required)
          .form-group-modern(style="flex: 1;")
            label Application End
            input.form-control-modern(type="datetime-local" name="application_end" step="any" required)
        
        div(style="display: flex; gap: 15px;")
          .form-group-modern(style="flex: 1;")
            label Task Start Date
            input.form-control-modern(type="datetime-local" name="task_start" step="any" required)
          .form-group-modern(style="flex: 1;")
            label Task End Date
            input.form-control-modern(type="datetime-local" name="task_end" step="any" required)
        
        .form-group-modern
          label Eligibility Rule (optional JSON)
          textarea.form-control-modern(name="eligibility_rule_json" rows="2" placeholder='e.g. {"min_scholarship_percentage": 50}')
          small(style="display: block; margin-top: 6px; color: var(--text-muted); font-size: 0.8rem;") Keys: min_scholarship_percentage, study_level, faculty.
        
        .form-group-modern(style="display: flex; gap: 30px; align-items: center; margin-top: 10px;")
          label(style="display: flex; gap: 8px; align-items: center; cursor: pointer; font-size: 0.95rem; color: var(--text-primary);")
            input(type="checkbox" name="auto_approve" style="width: 18px; height: 18px; accent-color: var(--accent);")
            | Auto-approve apps
          label(style="display: flex; gap: 8px; align-items: center; cursor: pointer; font-size: 0.95rem; color: var(--text-primary);")
            input(type="checkbox" name="has_waitlist" style="width: 18px; height: 18px; accent-color: var(--accent);")
            | Enable waitlist
        
        div(style="text-align: right; margin-top: 30px;")
          button.btn-modern.btn-modern-primary(type="submit" style="width: 100%; padding: 12px; font-size: 1rem;") Create Call
