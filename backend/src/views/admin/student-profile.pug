extends ../layout

block content
  style.
    .profile-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      animation: fadeIn 0.4s ease-out;
    }
    .profile-header {
      display: flex;
      align-items: center;
      gap: 25px;
      margin-bottom: 30px;
      padding-bottom: 25px;
      border-bottom: 1px solid var(--border-color);
    }
    .avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: var(--gradient-1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      font-weight: 700;
      color: white;
      box-shadow: 0 10px 20px rgba(244, 63, 94, 0.2);
    }
    .header-info h1 {
      margin: 0 0 5px 0;
      font-size: 2.2rem;
      color: var(--text-primary);
    }
    .header-info p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .badge-id {
      background: rgba(0,0,0,0.05);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.5px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 25px;
    }
    
    .card {
      background: var(--bg-card);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 25px;
      border: 1px solid var(--border-color);
      height: 100%;
    }
    .card h3 {
      margin-top: 0;
      margin-bottom: 20px;
      font-size: 1.2rem;
      color: var(--text-primary);
      border-bottom: 1px solid rgba(0,0,0,0.05);
      padding-bottom: 10px;
    }

    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .info-list li {
      display: flex;
      flex-direction: column;
      margin-bottom: 15px;
    }
    .info-list label {
      font-size: 0.8rem;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 3px;
    }
    .info-list span {
      font-size: 1rem;
      color: var(--text-primary);
      font-weight: 500;
    }

    /* Tables */
    table.modern-table { width: 100%; border-collapse: collapse; text-align: left; }
    table.modern-table th {
      background-color: rgba(0,0,0,0.02); color: var(--text-secondary); font-weight: 600;
      padding: 12px 15px; border-bottom: 2px solid var(--border-color);
      font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    table.modern-table td {
      padding: 15px; border-bottom: 1px solid rgba(0,0,0,0.05);
      color: var(--text-primary); font-size: 0.95rem; vertical-align: middle;
    }
    
    .status-badge {
      padding: 5px 10px; border-radius: 20px;
      font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    }
    .status-pending { background-color: rgba(245,158,11,0.15); color: var(--warning); }
    .status-approved { background-color: rgba(16,185,129,0.15); color: var(--success); }
    .status-rejected { background-color: rgba(239,68,68,0.15); color: var(--danger); }
    .status-under_review { background-color: rgba(99,102,241,0.15); color: #818cf8; }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 500;
      margin-bottom: 20px;
      transition: color 0.2s;
    }
    .btn-back:hover { color: var(--text-primary); }

    /* ── Circular Progress Ring ──────────────────────────── */
    .progress-ring-wrap {
      position: relative;
      width: 140px;
      height: 140px;
      flex-shrink: 0;
    }
    .progress-ring-wrap svg { transform: rotate(-90deg); }
    .ring-bg { stroke: var(--border-color); fill: none; }
    .ring-fill {
      fill: none;
      stroke-linecap: round;
      transition: stroke-dashoffset 1.2s cubic-bezier(0.4,0,0.2,1);
      stroke: url(#ringGradient);
    }
    .ring-center {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      line-height: 1.2;
    }
    .ring-pct {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    .ring-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 0.5px;
    }
    .points-summary {
      display: flex;
      gap: 20px;
      margin-top: 12px;
    }
    .pts-box {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 10px 18px;
      text-align: center;
    }
    .pts-val {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--accent);
    }
    .pts-lbl {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    /* ─────────────────────────────────────────────────────── */

  .profile-container
    a.btn-back(href="/admin/students") 
      span ←
      | Back to Students

    -
      // Compute ring stats from most recent period enrolment
      var activePE = (student.PeriodEnrolments && student.PeriodEnrolments.length)
        ? student.PeriodEnrolments.slice().sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt))[0]
        : null;
      var goalPts = activePE ? (activePE.goal_points || 0) : 0;
      var collectedPts = activePE ? (activePE.collected_points || 0) : 0;
      var pct = goalPts > 0 ? Math.min(Math.round((collectedPts / goalPts) * 100), 100) : 0;
      // SVG ring: r=54, circumference = 2*pi*54 ≈ 339.3
      var R = 54;
      var C = +(2 * Math.PI * R).toFixed(2);
      var offset = +(C - (pct / 100) * C).toFixed(2);
      var totalApps = (student.CallApplications && student.CallApplications.length) || 0;
      var approvedApps = (student.CallApplications || []).filter(function(a){ return a.status === 'approved'; }).length;

    .profile-header
      //- Avatar
      .avatar= student.first_name.charAt(0) + student.last_name.charAt(0)

      //- Name & ID
      .header-info(style="flex: 1;")
        h1 #{student.first_name} #{student.last_name}
        p 
          span.badge-id #{student.student_number}
          span #{student.email}
        .points-summary
          .pts-box
            .pts-val= collectedPts
            .pts-lbl Points Earned
          .pts-box
            .pts-val= goalPts
            .pts-lbl Period Goal
          .pts-box
            .pts-val #{approvedApps} / #{totalApps}
            .pts-lbl Applications

      //- Circular Progress Ring
      .progress-ring-wrap
        svg(width="140" height="140" viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg")
          defs
            linearGradient#ringGradient(x1="0%" y1="0%" x2="100%" y2="100%")
              stop(offset="0%" stop-color="#0ea5e9")
              stop(offset="100%" stop-color="#6366f1")
          circle.ring-bg(cx="70" cy="70" r=R stroke-width="12")
          circle.ring-fill#ringFill(
            cx="70" cy="70" r=R stroke-width="12"
            stroke-dasharray=C
            stroke-dashoffset=C
            data-offset=offset
          )
        .ring-center
          .ring-pct #{pct}%
          .ring-label Goal

    .grid
      //- Left Column: Academic Info
      .card
        h3 Academic Profile
        ul.info-list
          li
            label Faculty
            span= student.faculty || 'Not Specified'
          li
            label Department
            span= student.department || 'Not Specified'
          li
            label Program
            span= student.program || 'Not Specified'
          li
            label Study Level
            span= student.study_level || 'Not Specified'
          li
            label Enrolment Year
            span= student.enrolment_year || 'Not Specified'
          li
            label Scholarship
            span= student.scholarship_type ? `${student.scholarship_type} (${student.scholarship_percentage || 0}%)` : 'Not Specified'
          li
            label Status
            span(style=`color: ${student.is_active ? 'var(--success)' : 'var(--danger)'}`)
              | #{student.is_active ? 'Active' : 'Inactive'}

      //- Right Column: Activity
      div(style="display: flex; flex-direction: column; gap: 25px;")
        
        //- Period Enrolments & Points
        .card
          h3 Engagement Points & Periods
          if student.PeriodEnrolments && student.PeriodEnrolments.length > 0
            table.modern-table
              thead
                tr
                  th Period
                  th Goal
                  th Collected
                  th Result
              tbody
                each pe in student.PeriodEnrolments
                  tr
                    td(style="font-weight: 600;")= pe.Period.code
                    td= pe.goal_points || 0
                    td(style="color: var(--accent); font-weight: 700;")= pe.collected_points || 0
                    td
                      if pe.result_status
                        span.status-badge(class=`status-${pe.result_status.toLowerCase()}`)= pe.result_status
                      else
                        span.status-badge.status-pending IN PROGRESS
          else
            p(style="color: var(--text-muted); font-style: italic; margin: 0;") No period enrolments found.

        //- Event Call Applications
        .card
          h3 Event Applications
          if student.CallApplications && student.CallApplications.length > 0
            table.modern-table
              thead
                tr
                  th Call
                  th Status
                  th Points Awarded
                  th Date
              tbody
                each app in student.CallApplications
                  tr
                    td(style="font-weight: 500;")= app.Call ? app.Call.title : 'Unknown Call'
                    td
                      span.status-badge(class=`status-${app.status}`)= app.status.replace('_', ' ')
                    td
                      if app.points_awarded
                        span(style="color: var(--success); font-weight: 600;") +#{app.points_awarded} pts
                      else
                        span(style="color: var(--text-muted);") —
                    td(style="color: var(--text-muted); font-size: 0.85rem;")= new Date(app.created_at).toLocaleDateString()
          else
            p(style="color: var(--text-muted); font-style: italic; margin: 0;") No applications found.

  script.
    // Animate the progress ring on load
    window.addEventListener('DOMContentLoaded', function () {
      var ring = document.getElementById('ringFill');
      if (ring) {
        var target = parseFloat(ring.getAttribute('data-offset'));
        // Start fully hidden, then animate to the real offset
        ring.style.strokeDashoffset = ring.getAttribute('stroke-dasharray');
        requestAnimationFrame(function () {
          setTimeout(function () {
            ring.style.strokeDashoffset = target;
          }, 100);
        });
      }
    });
