extends ../layout

block content
  style.
    .import-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 20px;
      animation: fadeIn 0.4s ease-out;
    }
    body::-webkit-scrollbar, dialog::-webkit-scrollbar { display: none; }
    body, dialog { -ms-overflow-style: none; scrollbar-width: none; }

    .page-title-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--border-color);
    }
    .page-title-bar h1 { margin: 0; color: var(--text-primary); font-size: 2rem; font-weight: 600; }
    .page-title-bar p { margin: 5px 0 0; color: var(--text-secondary); font-size: 0.95rem; }
    .page-title-bar a {
      padding: 10px 20px; border-radius: 8px; font-weight: 500; border: 1px solid var(--border-color);
      color: var(--text-secondary); text-decoration: none; transition: all 0.2s;
    }
    .page-title-bar a:hover { color: var(--text-primary); border-color: var(--accent); }

    .card {
      background: var(--bg-card);
      border-radius: 14px;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow);
      padding: 30px;
      margin-bottom: 25px;
    }
    .card h2 { margin: 0 0 20px; color: var(--text-primary); font-size: 1.2rem; font-weight: 600; }

    .upload-zone {
      border: 2px dashed var(--border-color);
      border-radius: 12px;
      padding: 40px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s;
      background: var(--bg-input);
      margin-bottom: 20px;
      position: relative;
    }
    .upload-zone:hover, .upload-zone.dragover {
      border-color: var(--accent);
      background: rgba(244, 63, 94, 0.05);
    }
    .upload-zone input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-icon { font-size: 3rem; margin-bottom: 12px; }
    .upload-zone p { color: var(--text-secondary); margin: 5px 0; }
    .upload-zone .file-name { color: var(--accent); font-weight: 500; margin-top: 8px; display: none; }

    .btn-import {
      width: 100%; padding: 14px; border: none; border-radius: 10px; cursor: pointer;
      font-size: 1rem; font-weight: 600; color: white;
      background: var(--gradient-1);
      box-shadow: 0 4px 15px var(--accent-glow);
      transition: all 0.2s;
    }
    .btn-import:hover { transform: translateY(-1px); box-shadow: 0 6px 20px var(--accent-glow); }

    .result-card {
      border-radius: 14px; padding: 24px; margin-bottom: 25px;
      border: 1px solid var(--border-color);
    }
    .result-card.success-card { background: rgba(16, 185, 129, 0.08); border-color: rgba(16, 185, 129, 0.3); }
    .result-card.error-card  { background: rgba(244, 63, 94, 0.08);  border-color: rgba(244, 63, 94, 0.3); }
    .result-row { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 16px; }
    .stat-box {
      flex: 1; min-width: 120px; background: var(--bg-card);
      border-radius: 10px; padding: 16px; text-align: center; border: 1px solid var(--border-color);
    }
    .stat-num { font-size: 2.5rem; font-weight: 700; }
    .stat-num.green { color: var(--success); }
    .stat-num.yellow { color: var(--warning); }
    .stat-label { font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px; }

    .error-list { list-style: none; padding: 0; margin: 0; }
    .error-list li {
      padding: 8px 12px; background: rgba(244, 63, 94, 0.08); border-left: 3px solid var(--accent);
      border-radius: 0 6px 6px 0; margin-bottom: 6px; color: var(--text-primary); font-size: 0.9rem;
    }

    .template-table {
      width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 10px;
    }
    .template-table th {
      background: var(--bg-secondary); color: var(--text-secondary); padding: 10px 14px;
      text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;
      border-bottom: 2px solid var(--border-color);
    }
    .template-table td {
      padding: 10px 14px; border-bottom: 1px solid rgba(255,255,255,0.05);
      color: var(--text-primary);
    }
    .template-table tr:last-child td { border-bottom: none; }

    .required-tag {
      display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 2px 6px;
      border-radius: 4px; margin-left: 6px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .tag-required { background: rgba(244, 63, 94, 0.2); color: var(--accent); }
    .tag-optional { background: rgba(100, 116, 139, 0.2); color: var(--text-muted); }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

  .import-container
    .page-title-bar
      div
        h1 Import Students
        p Bulk-add students from an Excel file.
      a(href="/admin/users") ← Back to Users

    if imported !== null
      .result-card.success-card
        h2(style="margin: 0 0 16px; color: var(--text-primary);") Import Complete
        .result-row
          .stat-box
            div.stat-num.green= imported
            div.stat-label Students Created
          .stat-box
            div.stat-num.yellow= skipped
            div.stat-label Skipped (duplicate or invalid)
        if errList && errList.length
          h3(style="margin: 0 0 10px; color: var(--text-secondary); font-size: 0.95rem;") Row Issues
          ul.error-list
            each e in errList
              li= e

    if query && query.error === 'no_file'
      .result-card.error-card
        p(style="margin:0; color: var(--danger); font-weight:500;") ⚠ No file was uploaded. Please choose an Excel file.

    if query && query.error === 'parse_failed'
      .result-card.error-card
        p(style="margin:0; color: var(--danger); font-weight:500;") ⚠ Failed to parse the file. Please check the format and try again.

    .card
      h2 Upload Excel File
      form(action="/admin/students/import" method="POST" enctype="multipart/form-data" id="importForm")
        .upload-zone#dropZone
          input(type="file" name="excel_file" accept=".xlsx,.xls" id="fileInput")
          div.upload-icon 📊
          p(style="font-size: 1.05rem; color: var(--text-primary); font-weight: 500;") Drop your Excel file here
          p(style="font-size: 0.9rem;") or click to browse
          div.file-name#fileName

        button.btn-import(type="submit") Import Students

    .card
      h2 Expected Column Format
      p(style="color: var(--text-secondary); margin-bottom: 14px; font-size: 0.9rem;") Your spreadsheet's first row must be the header. Column names are flexible (case-insensitive). At minimum you need the three required columns.
      table.template-table
        thead
          tr
            th Column Name
            th Accepts Also
            th Example
            th Required
        tbody
          tr
            td name
            td first_name, firstname
            td John
            td span.required-tag.tag-required Required
          tr
            td surname
            td last_name, lastname
            td Doe
            td span.required-tag.tag-required Required
          tr
            td personal_university_id
            td university_id, universityid, university_number
            td UNIV-2026-0042
            td span.required-tag.tag-required Required
          tr
            td student_id
            td studentid, student_number
            td STU-001
            td span.required-tag.tag-optional Optional

  script.
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const fileName  = document.getElementById('fileName');

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) {
        fileName.textContent = '📎 ' + fileInput.files[0].name;
        fileName.style.display = 'block';
      }
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragover');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length) {
        fileInput.files = files;
        fileName.textContent = '📎 ' + files[0].name;
        fileName.style.display = 'block';
      }
    });
