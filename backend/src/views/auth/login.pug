extends ../layout

block content
  .auth-wrapper
    .auth-card
      h1 Welcome back
      p.subtitle Sign in to your SES account

      if error
        .alert.alert-error= error

      div(style="margin-top: 15px;")
        a.btn.btn-outline(href="/auth/mock-google" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px;")
          svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            circle(cx="12" cy="12" r="10")
            path(d="M12 16v-4")
            path(d="M12 8h.01")
          | Dev: Mock Admin Login

      div(style="margin-top: 10px; margin-bottom: 20px;")
        a.btn.btn-outline(href="/auth/mock-student" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; border-color: #22c55e; color: #166534; background: #f0fdf4;")
          svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
            circle(cx="12" cy="7" r="4")
          | Dev: Mock Student Login (Maria)

      form(action="/auth/login" method="POST")
        div(style="text-align: center; margin-bottom: 15px; color: #777;") OR

        .form-group
          label(for="email") Email Address
          input#email.form-control(
            type="email"
            name="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            value=email || ''
          )

        .form-group
          label(for="password") Password
          input#password.form-control(
            type="password"
            name="password"
            placeholder="Enter your password"
            required
            autocomplete="current-password"
          )

        button.btn.btn-primary.btn-block(type="submit") Sign In

      .auth-footer
        | Don't have an account?&nbsp;
        a(href="/auth/register") Create one
