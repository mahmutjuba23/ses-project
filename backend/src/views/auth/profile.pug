extends ../layout

block content
  .main-content
    .page-header
      div
        h1 My Profile
        p Your account details

    .profile-grid
      .card
        .profile-header
          .profile-avatar= user.full_name ? user.full_name.charAt(0).toUpperCase() : '?'
          .profile-info
            h2= user.full_name
            p= user.email

        .detail-row
          span.detail-label User ID
          span.detail-value= user.id

        .detail-row
          span.detail-label Email
          span.detail-value= user.email

        .detail-row
          span.detail-label Full Name
          span.detail-value= user.full_name

        .detail-row
          span.detail-label Status
          span.detail-value
            if user.is_active
              span.badge.badge-success
                span.badge-dot
                | Active
            else
              span.badge.badge-danger
                span.badge-dot
                | Inactive

        if user.created_at
          .detail-row
            span.detail-label Member Since
            span.detail-value= new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
