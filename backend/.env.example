# ── Mailtrap SMTP ──────────────────────────────────────────────────────────────
# Supported ports: 25, 465, 587, 2525
# TLS: Optional (STARTTLS on 25/587/2525; direct TLS on 465)
# Auth: PLAIN, LOGIN, CRAM-MD5
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
MAIL_FROM_NAME=SES System
MAIL_FROM_ADDRESS=noreply@ses.local